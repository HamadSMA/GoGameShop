@page "/cart"
@attribute [Authorize]
@attribute [StreamRendering]
@inject BasketState Basket

<PageTitle>Cart</PageTitle>
<h1>Your Cart</h1>

@if (basket is null)
{
    <p>Loading...</p>
}
else if (!basket.Items.Any())
{
    <p>Your cart is empty. <a href="/">Browse games</a></p>
}
else
{
    <div class="cart-layout">
        <ul class="cart-items">
            @foreach (var item in basket.Items)
            {
                <li class="cart-item">
                    <img src="@item.ImageUri" alt="@item.Name" />
                    <div>
                        <a href="/game/@item.Id">@item.Name</a>
                        <p class="price-tag">$@item.Price</p>
                    </div>

                    <form method="post" action="/basket/update">
                        <AntiforgeryToken />
                        <input type="hidden" name="gameId" value="@item.Id" />
                        <select name="quantity" onchange="this.form.submit()">
                            @for (var q = 1; q <= 10; q++)
                            {
                                var qty = q;
                                <option value="@qty" selected="@(qty == item.Quantity)">@qty</option>
                            }
                        </select>
                    </form>

                    <form method="post" action="/basket/remove">
                        <AntiforgeryToken />
                        <input type="hidden" name="gameId" value="@item.Id" />
                        <button type="submit" class="btn-danger">Remove</button>
                    </form>
                </li>
            }
        </ul>

        <div class="cart-summary">
            <h2>Summary</h2>
            <p>Items: @basket.Items.Sum(i => i.Quantity)</p>
            <p><strong>Total: $@basket.Items.Sum(i => i.Price * i.Quantity)</strong></p>
        </div>
    </div>
}

@code {
    private BasketDto? basket;

    protected override async Task OnInitializedAsync() =>
        basket = await Basket.GetBasketAsync();
}
