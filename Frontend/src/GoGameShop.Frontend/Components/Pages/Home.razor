@page "/"
@attribute [StreamRendering]
@inject GamesClient Games
@inject NavigationManager Nav

<PageTitle>GoGameShop</PageTitle>

<div class="carousel">
    <div class="carousel-slide active">
        <img src="/images/celeste.jpg" alt="Celeste" />
    </div>
    <div class="carousel-slide">
        <img src="/images/mgs2.jpg" alt="Metal Gear Solid 2" />
    </div>
    <div class="carousel-slide">
        <img src="/images/sotc.jpg" alt="Shadow of the Colossus" />
    </div>
    <button class="carousel-btn carousel-prev" onclick="carouselPrev()">&#8249;</button>
    <button class="carousel-btn carousel-next" onclick="carouselNext()">&#8250;</button>
    <div class="carousel-dots">
        <button class="carousel-dot active" onclick="carouselGo(0)"></button>
        <button class="carousel-dot" onclick="carouselGo(1)"></button>
        <button class="carousel-dot" onclick="carouselGo(2)"></button>
    </div>
</div>

@if (gamesPage is null)
{
    <p>Loading...</p>
}
else
{
    <div class="games-grid">
        @foreach (var game in gamesPage.Games)
        {
            <div class="game-card">
                <a href="/game/@game.Id" class="game-card-link">
                    <img src="@game.ImageUri" alt="@game.Name" />
                    <div class="game-card-body">
                        <h3>@game.Name</h3>
                        <p>@game.Genre &middot; @game.Rating</p>
                    </div>
                </a>
                <div class="game-card-footer">
                    <strong class="price-tag">$@game.Price</strong>
                    <form method="post" action="/basket/add">
                        <AntiforgeryToken />
                        <input type="hidden" name="gameId" value="@game.Id" />
                        <input type="hidden" name="returnUrl" value="@Nav.Uri" />
                        <button type="submit" class="btn-primary btn-sm js-add-to-cart">Add to Cart</button>
                    </form>
                </div>
            </div>
        }
    </div>
    <Pagination CurrentPage="page" TotalPages="gamesPage.TotalPages" BaseUrl="/" />
}

@code {
    [SupplyParameterFromQuery(Name = "page")] public int page { get; set; } = 1;

    private GamesPageDto? gamesPage;

    protected override async Task OnInitializedAsync() =>
        gamesPage = await Games.GetGamesAsync(page, pageSize: 12);
}
