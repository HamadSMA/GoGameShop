@page "/games/new"
@page "/games/{id:guid}/edit"
@attribute [Authorize(Roles = "Admin")]
@inject GamesClient Games
@inject LookupClient Lookup
@inject NavigationManager Nav

<PageTitle>@(Id is null ? "New Game" : "Edit Game")</PageTitle>
<h1>@(Id is null ? "New Game" : "Edit Game")</h1>

<form method="post" enctype="multipart/form-data" @formname="game-form" class="edit-form">
    <AntiforgeryToken />

    @if (!string.IsNullOrEmpty(imageUri))
    {
        <img src="@imageUri" class="preview-img" alt="Current image" />
    }

    <label>Name
        <input name="Form.Name" value="@Form!.Name" />
    </label>
    <label>Genre
        <select name="Form.GenreId">
            @foreach (var g in genres)
            {
                <option value="@g.GenreId" selected="@(g.GenreId == Form.GenreId)">@g.Name</option>
            }
        </select>
    </label>
    <label>Rating
        <select name="Form.RatingId">
            @foreach (var r in ratings)
            {
                <option value="@r.RatingId" selected="@(r.RatingId == Form.RatingId)">@r.Name</option>
            }
        </select>
    </label>
    <label>Price
        <input type="number" step="0.01" name="Form.Price" value="@Form.Price" />
    </label>
    <label>Release Date
        <input type="date" name="Form.ReleaseDate" value="@Form.ReleaseDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
    </label>
    <label>Description
        <textarea name="Form.Description">@Form.Description</textarea>
    </label>
    <label>Image
        <input type="file" name="Form.ImageFile" accept="image/*" />
    </label>

    <div class="form-actions">
        <button type="submit" class="btn-primary">Save</button>
        <a href="/catalog" class="btn-secondary">Cancel</a>
    </div>
</form>

@code {
    [Parameter] public Guid? Id { get; set; }
    [SupplyParameterFromForm(FormName = "game-form")] public GameFormModel? Form { get; set; }

    private IEnumerable<GenreDto>  genres  = [];
    private IEnumerable<RatingDto> ratings = [];
    private string? imageUri;

    protected override async Task OnInitializedAsync()
    {
        var formSubmitted = Form is not null;
        Form ??= new();

        var genresTask  = Lookup.GetGenresAsync();
        var ratingsTask = Lookup.GetRatingsAsync();
        genres  = await genresTask;
        ratings = await ratingsTask;

        if (formSubmitted)
        {
            if (Id is Guid id)
                await Games.UpdateGameAsync(id, Form);
            else
                await Games.CreateGameAsync(Form);

            Nav.NavigateTo("/catalog", forceLoad: true);
            return;
        }

        if (Id is Guid existingId)
        {
            var game = await Games.GetGameAsync(existingId);
            if (game is not null)
            {
                Form.Name        = game.Name;
                Form.GenreId     = game.GenreId;
                Form.RatingId    = game.RatingId;
                Form.Price       = game.Price;
                Form.ReleaseDate = game.ReleaseDate;
                Form.Description = game.Description;
                imageUri         = game.ImageUri;
            }
        }
    }
}
